<?php

/**
 * @file
 * Install and update hooks for Decoupled Settings.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\decoupled_settings\SettingsResolver;
use Drupal\decoupled_settings\ThemeManifest;

/**
 * Implements hook_install().
 *
 * Consumers that existed before this module got a NULL overrides column,
 * and Drupal 10's storage unserializes it without a null guard. Backfill
 * an empty map instead. A direct query on purpose: loading the entities
 * would trip the very deprecation this avoids.
 */
function decoupled_settings_install(): void {
  $connection = \Drupal::database();
  foreach (['consumer_field_data', 'consumer_field_revision'] as $table) {
    if ($connection->schema()->tableExists($table)) {
      $connection->update($table)
        ->fields([SettingsResolver::OVERRIDE_FIELD => serialize([])])
        ->isNull(SettingsResolver::OVERRIDE_FIELD)
        ->execute();
    }
  }
}

/**
 * Exclude system.site:mail_notification from the exposed settings.
 *
 * The shipped exclude list held system.site:mail but not the notification
 * address next to it. Append it for existing installs. A site that wants
 * the key exposed can remove it again: this hook runs once.
 */
function decoupled_settings_update_10001(): string {
  $config = \Drupal::configFactory()->getEditable('decoupled_settings.settings');
  $excluded = $config->get('excluded_keys') ?? [];
  if (!in_array('system.site:mail_notification', $excluded, TRUE)) {
    $excluded[] = 'system.site:mail_notification';
    $config->set('excluded_keys', $excluded)->save();
    return 'system.site:mail_notification is now excluded.';
  }
  return 'system.site:mail_notification was already excluded.';
}

/**
 * Add the theme manifest exposure flag, switched off.
 *
 * The manifest describes the active theme's regions and breakpoints. It is
 * new, so an existing site is not opted in to sending it: exposure stays a
 * decision an administrator makes.
 */
function decoupled_settings_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('decoupled_settings.settings');
  if ($config->get('expose_theme_manifest') === NULL) {
    $config->set('expose_theme_manifest', FALSE)->save();
    return 'The theme manifest is available on the settings form, switched off.';
  }
  return 'The theme manifest flag was already set.';
}

/**
 * Add the theme field to the consumer entity.
 *
 * Existing consumers keep an empty value, which means they follow the site
 * default. So nothing about an existing site's responses changes until an
 * administrator picks a theme for a consumer.
 */
function decoupled_settings_update_10003(): string {
  $definition = BaseFieldDefinition::create('string')
    ->setLabel(t('Theme'))
    ->setDescription(t('The theme this consumer renders as. Its regions and settings are what this consumer reads. Leave empty to follow the site default.'))
    ->setRevisionable(TRUE)
    ->setDisplayOptions('form', ['type' => 'string_textfield', 'weight' => 90])
    ->setDisplayConfigurable('form', TRUE);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition(
      ThemeManifest::THEME_FIELD,
      'consumer',
      'decoupled_settings',
      $definition
    );

  return 'Consumers can now select the theme they render as.';
}
